# Vite's development proxy forwards SDK mock inference here.
NINFER_SERVER_URL=http://127.0.0.1:18080

# Set this to the model ID reported by ninfer's /v1/models endpoint.
VITE_NINFER_MODEL=qwen3.8-27b

# Total reasoning + answer budget. Must fit beside the prompt in --max-context.
VITE_NINFER_MAX_TOKENS=131072
